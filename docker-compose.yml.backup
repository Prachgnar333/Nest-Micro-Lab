# ===== NO VERSION LINE (removed to fix warning) =====

services:
  # ===== MESSAGE QUEUE =====
  rabbitmq:
    image: rabbitmq:3-management
    container_name: rabbitmq
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: admin
      RABBITMQ_DEFAULT_PASS: admin
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ===== DATABASES =====
  
  # Postgres for API Gateway
  postgres:
    image: postgres:16
    container_name: nest-lab-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: nest_lab
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Postgres for Auth Service
  auth-db:
    image: postgres:16
    container_name: auth-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: auth_db
    ports:
      - "5433:5432"
    volumes:
      - auth-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Postgres for Order Worker
  order-worker-db:
    image: postgres:16
    container_name: order-worker-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: order_worker
    ports:
      - "5434:5432"
    volumes:
      - order-worker-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ===== MICROSERVICES =====
  
  # API Gateway - Main entry point
  api-gateway:
    build:
      context: ./apps/api-gateway        # ✅ Updated path
      dockerfile: Dockerfile.dev
    container_name: api-gateway
    ports:
      - "3000:3000"
    environment:
      # Database
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USER: postgres
      DB_PASS: postgres
      DB_NAME: nest_lab
      
      # RabbitMQ
      RABBITMQ_URL: amqp://admin:admin@rabbitmq:5672
      
      # Security
      API_KEY: "your-secret-api-key-123"
      
      # Development
      CHOKIDAR_USEPOLLING: "true"
      NODE_ENV: development
    volumes:
      - ./apps/api-gateway:/app          # ✅ Updated path
      - /app/node_modules
    depends_on:
      rabbitmq:
        condition: service_healthy
      postgres:
        condition: service_healthy

  # Auth Service - Authentication & Authorization
  auth-service:
    build:
      context: ./apps/auth-service       # ✅ Correct path
      dockerfile: Dockerfile.dev
    container_name: auth-service
    command: npm run start:dev
    ports:
      - "3001:3000"
    environment:
      # Database
      DB_HOST: auth-db
      DB_PORT: "5432"
      DB_USER: postgres
      DB_PASS: postgres
      DB_NAME: auth_db
      
      # JWT
      JWT_ACCESS_SECRET: "your-super-secret-access-key-change-in-production"
      JWT_REFRESH_SECRET: "your-super-secret-refresh-key-change-in-production"
      JWT_ACCESS_EXPIRATION: "15m"
      JWT_REFRESH_EXPIRATION: "7d"
      
      # RabbitMQ
      RABBITMQ_URL: amqp://admin:admin@rabbitmq:5672
      
      # Development
      CHOKIDAR_USEPOLLING: "true"
      NODE_ENV: development
      PORT: 3000
    volumes:
      - ./apps/auth-service:/app         # ✅ Correct path
      - /app/node_modules
    depends_on:
      auth-db:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy

  # Order Worker - Background order processing
  order-worker:
    build:
      context: ./apps/order-worker       # ✅ Updated path
      dockerfile: Dockerfile.dev
    container_name: order-worker
    command: npm run start:dev
    environment:
      # Database
      POSTGRES_HOST: order-worker-db
      POSTGRES_PORT: "5432"
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: order_worker
      
      # RabbitMQ
      RABBITMQ_URL: amqp://admin:admin@rabbitmq:5672
      
      # Development
      CHOKIDAR_USEPOLLING: "true"
      NODE_ENV: development
    volumes:
      - ./apps/order-worker:/app         # ✅ Updated path
      - /app/node_modules
    depends_on:
      rabbitmq:
        condition: service_healthy
      order-worker-db:
        condition: service_healthy

volumes:
  pgdata:
  auth-pgdata:
  order-worker-pgdata: