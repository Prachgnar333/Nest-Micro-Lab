{
  "name": "ecom-microservices",
  "version": "1.0.0",
  "description": "E-Commerce Microservices Architecture with NestJS",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "logs": "docker-compose logs -f",
    "logs:gateway": "docker-compose logs -f api-gateway",
    "logs:auth": "docker-compose logs -f auth-service",
    "logs:orders": "docker-compose logs -f order-worker",
    "build": "docker-compose up --build -d",
    "restart": "docker-compose restart",
    "ps": "docker-compose ps"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/node": "^25.0.6"
  }
}
